// LAUNCH
function launch(){
  if(!mode)return;
  if(mode==='carte'){startMap();return;}
  let pool;
  if(mode==='sprint'){
    const src=[...DB.capitales.map(d=>({...d,_pool:DB.capitales})),...DB.fleuves.map(d=>({...d,_pool:DB.fleuves})),...DB.montagnes.map(d=>({...d,_pool:DB.montagnes})),...DB.pays.map(d=>({...d,_pool:DB.pays}))];
    pool=src;
  } else {
    pool=DB[mode].map(d=>({...d,_pool:DB[mode]}));
  }
  shuffle(pool);
  const take=mode==='sprint'?pool.length:Math.min(10,pool.length);
  qs=pool.slice(0,take).map(q=>{
    const src=q._pool||DB.capitales;
    const wrongs=shuffle(src.filter(x=>x.a!==q.a).map(x=>x.a)).slice(0,3);
    const fb=['Europe','Asie','Afrique','Amérique du Nord','Océanie','Pakistan','Brésil','Russie','Chine','Inde'];
    const used=new Set([...wrongs,q.a]);
    for(const f of fb){if(!used.has(f)&&wrongs.length<3){wrongs.push(f);used.add(f);}}
    return{...q,opts:shuffle([q.a,...wrongs.slice(0,3)])};
  });
  qi=0;score=0;ok=0;ko=0;streak=0;bestStreak=0;answered=false;
  show('quiz');
  const tc=document.getElementById('timeChip');
  if(mode==='sprint'){tc.classList.add('vis');startTimer();}else{tc.classList.remove('vis','hot');}
  renderQ();
}

// TIMER
function startTimer(){timeLeft=60;const el=document.getElementById('timeChip');el.textContent='60';timerID=setInterval(()=>{timeLeft--;el.textContent=timeLeft;el.classList.toggle('hot',timeLeft<=10);if(timeLeft<=0){stopTimer();showResults();}},1000);}
function stopTimer(){if(timerID){clearInterval(timerID);timerID=null;}const el=document.getElementById('timeChip');if(el){el.classList.remove('vis','hot');}}

// RENDER Q
function renderQ(){
  const q=qs[qi];if(!q){showResults();return;}
  answered=false;
  document.getElementById('pbarFill').style.width=(qi/qs.length*100)+'%';
  document.getElementById('qNumChip').textContent=`Q ${qi+1}/${qs.length}`;
  document.getElementById('scoreVal').textContent=score;
  const sc=document.getElementById('streakChip');
  if(streak>=2){sc.classList.add('vis');document.getElementById('streakVal').textContent=streak;}
  else sc.classList.remove('vis');
  const body=document.getElementById('qbody');
  body.innerHTML='';body.className='qbody q-in';
  const colors={capitales:'var(--gold)',fleuves:'var(--cyan)',montagnes:'var(--red)',pays:'var(--green)',sprint:'var(--violet)'};
  const card=document.createElement('div');card.className='q-card';
  card.style.setProperty('--qbar',colors[mode]||'var(--gold)');
  card.innerHTML=`<div class="q-num">Question ${qi+1} / ${qs.length}</div><span class="q-flag">${q.flag||'🌍'}</span><div class="q-text">${q.q}</div><div class="q-fact" id="qFact">${q.info||''}</div>`;
  body.appendChild(card);
  if(diff==='facile'){
    const wrap=document.createElement('div');wrap.className='mcq';
    const ltrs=['A','B','C','D'];
    (q.opts||[]).forEach((opt,i)=>{
      const btn=document.createElement('button');btn.className='mcq-btn';
      btn.innerHTML=`<span class="mcq-ltr">${ltrs[i]}</span>${opt}`;
      btn.addEventListener('click',()=>checkMCQ(opt,q.a,btn,q));
      wrap.appendChild(btn);
    });
    body.appendChild(wrap);
  } else {
    const wrap=document.createElement('div');wrap.className='txt-row';
    const inp=document.createElement('input');inp.type='text';inp.className='txt-inp';inp.id='tInp';
    inp.placeholder=diff==='difficile'?'Réponse exacte…':'Ta réponse…';inp.autocomplete='off';
    inp.addEventListener('keydown',e=>{if(e.key==='Enter')checkText(q);});
    const btn=document.createElement('button');btn.className='btn-val';btn.textContent='Valider';
    btn.addEventListener('click',()=>checkText(q));
    wrap.appendChild(inp);wrap.appendChild(btn);body.appendChild(wrap);
    setTimeout(()=>inp.focus(),80);
  }
  const fb=document.createElement('div');fb.className='fb';fb.id='fb';body.appendChild(fb);
  const nxt=document.createElement('button');nxt.className='btn-next';nxt.id='nxtBtn';nxt.textContent='Question suivante →';
  nxt.addEventListener('click',()=>{qi++;renderQ();});body.appendChild(nxt);
}

// CHECK
function checkMCQ(chosen,correct,btn,q){
  if(answered)return;answered=true;
  document.querySelectorAll('.mcq-btn').forEach(b=>b.disabled=true);
  if(chosen===correct){btn.classList.add('hit');doWin(q);}
  else{btn.classList.add('miss');document.querySelectorAll('.mcq-btn').forEach(b=>{if(b.textContent.trim().slice(1)===correct)b.classList.add('hit');});doLoss(q);}
  revealFact();document.getElementById('nxtBtn').classList.add('vis');
  if(mode==='sprint')setTimeout(()=>{qi++;renderQ();},850);
}
function checkText(q){
  if(answered)return;
  const inp=document.getElementById('tInp');if(!inp)return;
  const v=inp.value.trim();if(!v)return;
  answered=true;inp.disabled=true;
  const vb=document.querySelector('.btn-val');if(vb)vb.disabled=true;
  const pass=diff==='difficile'?norm(v)===norm(q.a)||lev(norm(v),norm(q.a))<=1:norm(q.a).includes(norm(v))||norm(v).includes(norm(q.a))||lev(norm(v),norm(q.a))<=2;
  if(pass){inp.classList.add('hit');doWin(q);}else{inp.classList.add('miss');doLoss(q);}
  revealFact();document.getElementById('nxtBtn').classList.add('vis');
  if(mode==='sprint')setTimeout(()=>{qi++;renderQ();},850);
}
function doWin(q){streak++;bestStreak=Math.max(streak,bestStreak);const bonus=streak>=3?streak*2:0;const pts=(diff==='difficile'?15:10)+bonus;score+=pts;ok++;document.getElementById('scoreVal').textContent=score;const fb=document.getElementById('fb');fb.className='fb vis hit';fb.innerHTML=`<span class="fb-ico">✅</span><span class="fb-msg">Correct !${bonus>0?` <strong>+${bonus} pts combo 🔥</strong>`:''}</span>`;}
function doLoss(q){streak=0;ko++;const fb=document.getElementById('fb');fb.className='fb vis miss';fb.innerHTML=`<span class="fb-ico">❌</span><span class="fb-msg">Faux — c'était : <strong>${q.a}</strong></span>`;}
function revealFact(){const f=document.getElementById('qFact');if(f&&f.textContent.trim())f.classList.add('vis');}

// MAP MODE
function startMap(){mapQs=shuffle([...MAP_DATA]).slice(0,10);mapQi=0;mapScore=0;ok=0;ko=0;streak=0;bestStreak=0;score=0;show('mapscreen');renderMapQ();}
function renderMapQ(){
  const q=mapQs[mapQi];if(!q){score=mapScore;showResults();return;}
  mapClicked=false;
  document.getElementById('mFlag').textContent=q.flag;
  document.getElementById('mQTxt').textContent=`Où se trouve ${q.n} ?`;
  document.getElementById('mQCat').textContent=q.cat;
  document.getElementById('mQNum').textContent=`${mapQi+1}/10`;
  document.getElementById('mScoreVal').textContent=mapScore;
  document.getElementById('mPbarFill').style.width=(mapQi/10*100)+'%';
  document.getElementById('pinsSvg').innerHTML='';
  document.getElementById('mapPopup').classList.remove('vis');
  const h=document.getElementById('clickHint');h.classList.remove('gone');h.style.visibility='visible';
}
function onMapClick(e){
  if(mapClicked)return;mapClicked=true;
  const q=mapQs[mapQi];if(!q)return;
  const wrap=document.getElementById('mapWrap');
  const rect=wrap.getBoundingClientRect();
  const gx=((e.clientX-rect.left)/rect.width)*100;
  const gy=((e.clientY-rect.top)/rect.height)*100;
  document.getElementById('clickHint').classList.add('gone');
  addPin(gx,gy,'#b48eff','#7c3aed','?');
  setTimeout(()=>{
    addPin(q.x,q.y,'#22d982','#16a34a',q.flag);
    addLine(gx,gy,q.x,q.y);addLabel(q.x,q.y,q.n);
    const d=Math.sqrt((gx-q.x)**2+(gy-q.y)**2);
    const km=Math.round(d*310);
    let pts=0,col='#ff4d6d';
    if(km<80){pts=500;col='#22d982';}else if(km<300){pts=400;col='#4ade80';}else if(km<700){pts=300;col='#fde68a';}else if(km<1500){pts=200;col='#f0b429';}else if(km<3000){pts=100;col='#fb923c';}else if(km<5000){pts=50;col='#f87171';}
    mapScore+=pts;ok++;
    const pd=document.getElementById('popDist'),ps=document.getElementById('popSub');
    pd.style.color=col;pd.textContent=km<80?'🎯 Parfait !':km+' km';
    ps.innerHTML=`<strong style="color:${col}">+${pts}</strong> points`;
    document.getElementById('mapPopup').classList.add('vis');
  },380);
}
function nextMapQ(){mapQi++;if(mapQi>=mapQs.length){score=mapScore;showResults();}else renderMapQ();}
function addPin(xp,yp,c1,c2,lbl){
  const svg=document.getElementById('pinsSvg');
  const x=xp/100*2000,y=yp/100*1001;
  const id='p'+Math.random().toString(36).slice(2,8);
  const g=document.createElementNS('http://www.w3.org/2000/svg','g');
  g.innerHTML=`<defs><radialGradient id="${id}" cx="40%" cy="30%" r="70%"><stop offset="0%" stop-color="${c1}"/><stop offset="100%" stop-color="${c2}"/></radialGradient></defs><circle cx="${x}" cy="${y}" r="22" fill="${c1}" opacity="0.15"/><circle cx="${x}" cy="${y}" r="12" fill="url(#${id})" stroke="rgba(255,255,255,.4)" stroke-width="1.5"/><text x="${x}" y="${y+5}" text-anchor="middle" font-size="12" fill="white">${lbl}</text>`;
  svg.appendChild(g);
}
function addLine(x1p,y1p,x2p,y2p){
  const svg=document.getElementById('pinsSvg');
  const el=document.createElementNS('http://www.w3.org/2000/svg','line');
  el.setAttribute('x1',x1p/100*2000);el.setAttribute('y1',y1p/100*1001);
  el.setAttribute('x2',x2p/100*2000);el.setAttribute('y2',y2p/100*1001);
  el.setAttribute('stroke','rgba(255,255,255,.3)');el.setAttribute('stroke-width','2');el.setAttribute('stroke-dasharray','7 5');
  svg.appendChild(el);
}
function addLabel(xp,yp,text){
  const svg=document.getElementById('pinsSvg');
  const x=xp/100*2000,y=yp/100*1001;
  const w=text.length*8+18;
  const g=document.createElementNS('http://www.w3.org/2000/svg','g');
  g.innerHTML=`<rect x="${x-w/2}" y="${y-42}" width="${w}" height="22" rx="6" fill="rgba(4,6,15,.88)" stroke="rgba(34,217,130,.4)" stroke-width="1"/><text x="${x}" y="${y-26}" text-anchor="middle" font-family="Outfit,sans-serif" font-size="13" font-weight="700" fill="#22d982">${text}</text>`;
  svg.appendChild(g);
}

// RESULTS
function showResults(){
  stopTimer();
  const tot=mode==='carte'?mapQs.length:qs.length;
  const pct=tot>0?Math.round((ok/tot)*100):0;
  const canvas=document.getElementById('resCanvas');
  const ctx=canvas.getContext('2d');
  const cx=78,cy=78,R=66;
  ctx.clearRect(0,0,156,156);
  ctx.beginPath();ctx.arc(cx,cy,R,0,Math.PI*2);ctx.strokeStyle='rgba(255,255,255,.06)';ctx.lineWidth=9;ctx.stroke();
  if(pct>0){const end=(pct/100)*Math.PI*2-Math.PI/2;ctx.beginPath();ctx.arc(cx,cy,R,-Math.PI/2,end);const g=ctx.createLinearGradient(cx-R,cy,cx+R,cy);g.addColorStop(0,'#fde68a');g.addColorStop(1,'#f0b429');ctx.strokeStyle=g;ctx.lineWidth=9;ctx.lineCap='round';ctx.stroke();}
  document.getElementById('resBigNum').textContent=mode==='carte'?mapScore:ok;
  document.getElementById('resDenom').textContent=mode==='carte'?'pts':`/ ${tot}`;
  document.getElementById('rsOk').textContent=ok;
  document.getElementById('rsKo').textContent=ko;
  document.getElementById('rsPts').textContent=score;
  document.getElementById('rsBest').textContent=bestStreak;
  const msgs=[[90,'🏆 LÉGENDAIRE !','Tu es un génie de la géographie mondiale.'],[70,'🌟 EXCELLENT !','Belle maîtrise du monde, chapeau !'],[50,'👍 PAS MAL !','Continue, tu progresses !'],[0,'📚 CONTINUE !','La géo s\'apprend avec de la pratique.']];
  const [,t,s]=msgs.find(([p])=>pct>=p);
  document.getElementById('resTitle').textContent=t;
  document.getElementById('resSub').textContent=s;
  show('results');
  if(pct>=70)launchConfetti();
}

// CONFETTI
function launchConfetti(){
  const c=document.getElementById('confetti');
  c.width=innerWidth;c.height=innerHeight;c.style.display='block';
  const ctx=c.getContext('2d');
  const cols=['#f0b429','#fde68a','#00eeff','#22d982','#b48eff','#ff4d6d','#fff'];
  const ps=Array.from({length:130},()=>({x:Math.random()*c.width,y:-Math.random()*200-20,vx:(Math.random()-.5)*4,vy:Math.random()*4+2,r:Math.random()*7+3,rot:Math.random()*360,rv:(Math.random()-.5)*7,col:cols[Math.floor(Math.random()*cols.length)],rect:Math.random()>.5}));
  let f=0;
  function draw(){ctx.clearRect(0,0,c.width,c.height);ps.forEach(p=>{ctx.save();ctx.globalAlpha=Math.max(0,1-f/160);ctx.translate(p.x,p.y);ctx.rotate(p.rot*Math.PI/180);ctx.fillStyle=p.col;if(p.rect){ctx.fillRect(-p.r,-p.r/2,p.r*2,p.r);}else{ctx.beginPath();ctx.arc(0,0,p.r*.5,0,Math.PI*2);ctx.fill();}ctx.restore();p.x+=p.vx;p.y+=p.vy;p.vy+=.06;p.rot+=p.rv;});f++;if(f<200)requestAnimationFrame(draw);else{ctx.clearRect(0,0,c.width,c.height);c.style.display='none';}}
  draw();
}

</script>
