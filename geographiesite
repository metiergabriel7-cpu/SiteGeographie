<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>GéoQuiz · Explore le Monde</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Outfit:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
html{height:100%}
body{min-height:100%;background:#04060f;color:#eef0f8;font-family:'Outfit',sans-serif;-webkit-font-smoothing:antialiased;overflow-x:hidden}
:root{
  --gold:#f0b429;--gold2:#fde68a;--cyan:#00eeff;--green:#22d982;--red:#ff4d6d;
  --violet:#b48eff;--orange:#ff8c42;
  --s1:#0b0e1c;--s2:#111626;--s3:#1a2038;
  --border:rgba(255,255,255,.07);--border2:rgba(255,255,255,.13);
  --dim:#5a6480;--muted:#8892b0;
}
body::before{content:'';position:fixed;inset:0;z-index:0;pointer-events:none;
  background:radial-gradient(ellipse 900px 600px at 15% -5%,rgba(240,180,41,.055) 0%,transparent 60%),
  radial-gradient(ellipse 700px 500px at 85% 105%,rgba(0,238,255,.04) 0%,transparent 55%),
  radial-gradient(ellipse 500px 400px at 50% 60%,rgba(180,142,255,.025) 0%,transparent 55%)}
::-webkit-scrollbar{width:4px}::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:rgba(255,255,255,.1);border-radius:4px}

/* SCREENS */
.screen{display:none;position:relative;z-index:1}
.screen.act{display:flex;flex-direction:column;min-height:100vh}

/* HOME */
#home{align-items:center;justify-content:center;padding:48px 20px 60px;gap:40px}

/* Globe */
.globe-outer{position:relative;width:160px;height:160px;flex-shrink:0;animation:gFloat 7s ease-in-out infinite}
@keyframes gFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-14px)}}
.globe-ball{width:160px;height:160px;border-radius:50%;
  background:radial-gradient(circle at 38% 30%,#1a4a70 0%,#0d2d4a 40%,#061422 80%);
  box-shadow:0 0 0 1px rgba(0,238,255,.18),0 0 50px rgba(0,238,255,.07),0 30px 60px rgba(0,0,0,.6),
  inset -30px -20px 50px rgba(0,0,0,.5),inset 16px 12px 30px rgba(0,238,255,.06);
  position:relative;overflow:hidden}
.globe-ball::before{content:'';position:absolute;inset:0;
  background:repeating-linear-gradient(0deg,transparent 0,transparent 22px,rgba(0,238,255,.03) 22px,rgba(0,238,255,.03) 23px)}
.globe-ball::after{content:'';position:absolute;inset:0;
  background:repeating-linear-gradient(90deg,transparent 0,transparent 32px,rgba(0,238,255,.025) 32px,rgba(0,238,255,.025) 33px)}
.globe-shine{position:absolute;top:20px;left:30px;width:44px;height:26px;
  background:radial-gradient(ellipse,rgba(255,255,255,.13) 0%,transparent 70%);
  border-radius:50%;transform:rotate(-25deg)}
.globe-ring{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%) rotateX(72deg);
  width:210px;height:210px;border-radius:50%;border:1px solid rgba(0,238,255,.13);pointer-events:none}
.globe-ring2{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%) rotateX(72deg);
  width:242px;height:242px;border-radius:50%;border:1px solid rgba(0,238,255,.05);pointer-events:none}

/* Hero */
.hero{text-align:center;max-width:540px}
.eyebrow{display:inline-flex;align-items:center;gap:9px;font-family:'JetBrains Mono',monospace;
  font-size:10.5px;letter-spacing:.2em;color:var(--gold);text-transform:uppercase;margin-bottom:18px}
.eyebrow span{width:28px;height:1px;background:var(--gold);opacity:.5;display:block}
h1.title{font-family:'Bebas Neue',sans-serif;font-size:clamp(80px,18vw,148px);line-height:.84;letter-spacing:.025em;margin-bottom:16px}
.t1{display:block;background:linear-gradient(160deg,#fff 0%,#c9d4ff 50%,#9aaeff 100%);
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.t2{display:block;background:linear-gradient(135deg,var(--gold2),var(--gold),#d97706);
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;
  filter:drop-shadow(0 0 40px rgba(240,180,41,.35))}
.hero-desc{font-size:15px;font-weight:300;color:var(--muted);line-height:1.75}
.hero-desc b{color:var(--gold);font-weight:600}

/* Badges */
.badges{display:flex;gap:8px;flex-wrap:wrap;justify-content:center}
.badge{display:flex;align-items:center;gap:6px;padding:5px 13px;border-radius:100px;
  font-family:'JetBrains Mono',monospace;font-size:11px;
  background:var(--s2);border:1px solid var(--border2);color:var(--dim)}
.badge b{color:var(--muted)}

/* Config */
.config{width:100%;max-width:540px}
.sec-head{display:flex;align-items:center;gap:12px;margin-bottom:14px}
.sec-lbl{font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:.18em;color:var(--dim);text-transform:uppercase;white-space:nowrap}
.sec-line{flex:1;height:1px;background:var(--border)}
.mode-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:24px}
@media(max-width:440px){.mode-grid{grid-template-columns:repeat(2,1fr)}}

.mc{background:var(--s2);border:1px solid var(--border);border-radius:16px;padding:20px 12px;
  cursor:pointer;text-align:center;transition:all .22s cubic-bezier(.4,0,.2,1);
  position:relative;overflow:hidden;user-select:none}
.mc:hover{transform:translateY(-3px);border-color:var(--border2);background:var(--s3)}
.mc.on{border-color:var(--mc-col,var(--gold));background:rgba(var(--mc-rgb,240,180,41),0.07);transform:translateY(-3px)}
.mc.on::after{content:'✓';position:absolute;top:8px;right:11px;font-size:11px;font-weight:700;color:var(--mc-col,var(--gold))}
.mc[data-m="capitales"]{--mc-col:var(--gold);--mc-rgb:240,180,41}
.mc[data-m="fleuves"]{--mc-col:var(--cyan);--mc-rgb:0,238,255}
.mc[data-m="montagnes"]{--mc-col:var(--red);--mc-rgb:255,77,109}
.mc[data-m="pays"]{--mc-col:var(--green);--mc-rgb:34,217,130}
.mc[data-m="carte"]{--mc-col:var(--violet);--mc-rgb:180,142,255}
.mc[data-m="sprint"]{--mc-col:var(--orange);--mc-rgb:255,140,66}
.mc-ico{font-size:30px;display:block;margin-bottom:9px;line-height:1}
.mc-name{font-size:13px;font-weight:700;display:block;color:#eef0f8}
.mc-sub{font-size:11px;color:var(--dim);margin-top:2px;display:block;line-height:1.4}

/* Difficulty */
.diff-row{display:flex;gap:8px;margin-bottom:28px}
.db{flex:1;padding:14px 10px;border-radius:13px;border:1px solid var(--border);background:var(--s2);
  color:var(--dim);font-family:'Outfit',sans-serif;font-size:13px;font-weight:600;cursor:pointer;
  transition:all .2s;text-align:center;line-height:1.35}
.db:hover{border-color:var(--border2);color:var(--muted)}
.db[data-d="facile"].on{border-color:var(--green);color:var(--green);background:rgba(34,217,130,.07)}
.db[data-d="moyen"].on{border-color:var(--gold);color:var(--gold);background:rgba(240,180,41,.07)}
.db[data-d="difficile"].on{border-color:var(--red);color:var(--red);background:rgba(255,77,109,.07)}

.btn-go{width:100%;padding:19px;border:none;border-radius:15px;
  background:linear-gradient(135deg,var(--gold2),var(--gold) 50%,#d97706);
  color:#160c00;font-family:'Outfit',sans-serif;font-size:17px;font-weight:800;letter-spacing:.02em;
  cursor:pointer;position:relative;overflow:hidden;transition:all .25s;
  box-shadow:0 4px 28px rgba(240,180,41,.28),0 1px 0 rgba(255,255,255,.18) inset}
.btn-go::before{content:'';position:absolute;inset:0;
  background:linear-gradient(90deg,transparent,rgba(255,255,255,.16),transparent);
  transform:translateX(-100%);transition:transform .45s}
.btn-go:hover{transform:translateY(-2px);box-shadow:0 10px 50px rgba(240,180,41,.42)}
.btn-go:hover::before{transform:translateX(100%)}
.btn-go:active{transform:translateY(0)}
.btn-go:disabled{opacity:.3;cursor:not-allowed;transform:none;box-shadow:none}

/* TOPBAR */
#quiz{background:var(--s1)}
.topbar{display:flex;align-items:center;justify-content:space-between;padding:12px 18px;gap:10px;
  background:rgba(4,6,15,.92);border-bottom:1px solid var(--border);backdrop-filter:blur(18px);
  position:sticky;top:0;z-index:50}
.tb-left{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.chip{display:flex;align-items:center;gap:6px;padding:6px 13px;border-radius:100px;
  font-family:'JetBrains Mono',monospace;font-size:12px}
.chip-score{background:rgba(240,180,41,.1);border:1px solid rgba(240,180,41,.22);color:var(--gold)}
.chip-q{background:var(--s2);border:1px solid var(--border);color:var(--dim);font-size:11px}
.chip-streak{background:rgba(34,217,130,.09);border:1px solid rgba(34,217,130,.22);color:var(--green);display:none}
.chip-streak.vis{display:flex}
.chip-time{background:rgba(255,77,109,.09);border:1px solid rgba(255,77,109,.22);color:var(--red);
  font-family:'Bebas Neue',sans-serif;font-size:20px;letter-spacing:.05em;padding:3px 14px;display:none}
.chip-time.vis{display:flex}
.chip-time.hot{animation:hotPulse .55s ease infinite alternate}
@keyframes hotPulse{from{opacity:1}to{opacity:.45}}
.btn-quit{background:none;border:1px solid var(--border);color:var(--dim);border-radius:100px;
  padding:6px 15px;font-family:'Outfit',sans-serif;font-size:13px;cursor:pointer;transition:all .18s}
.btn-quit:hover{border-color:var(--red);color:var(--red)}
.pbar{height:2px;background:rgba(255,255,255,.04);overflow:hidden}
.pbar-fill{height:100%;background:linear-gradient(90deg,var(--gold),var(--cyan));
  transition:width .55s cubic-bezier(.4,0,.2,1);box-shadow:0 0 10px rgba(240,180,41,.5)}

/* QUIZ BODY */
.qbody{flex:1;display:flex;flex-direction:column;max-width:620px;width:100%;margin:0 auto;padding:30px 18px 48px;gap:18px}
.q-in{animation:qSlide .35s cubic-bezier(.4,0,.2,1) both}
@keyframes qSlide{from{opacity:0;transform:translateY(14px) scale(.99)}to{opacity:1;transform:translateY(0) scale(1)}}
.q-card{background:var(--s2);border:1px solid var(--border);border-radius:22px;padding:28px 26px;position:relative;overflow:hidden}
.q-card::before{content:'';position:absolute;top:0;left:0;right:0;height:1px;
  background:linear-gradient(90deg,transparent,var(--qbar,var(--gold)) 50%,transparent);opacity:.6}
.q-num{font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:.14em;color:var(--dim);text-transform:uppercase;margin-bottom:16px}
.q-flag{font-size:50px;line-height:1;display:block;margin-bottom:14px;filter:drop-shadow(0 4px 14px rgba(0,0,0,.45))}
.q-text{font-size:20px;font-weight:600;line-height:1.4;color:#eef0f8}
.q-fact{margin-top:14px;padding:11px 15px;background:rgba(0,238,255,.04);
  border-left:2px solid rgba(0,238,255,.3);border-radius:0 10px 10px 0;
  font-size:13px;color:var(--muted);line-height:1.65;display:none}
.q-fact.vis{display:block}

/* MCQ */
.mcq{display:flex;flex-direction:column;gap:9px}
.mcq-btn{display:flex;align-items:center;gap:13px;padding:15px 17px;
  background:rgba(255,255,255,.03);border:1px solid var(--border);border-radius:13px;
  color:#eef0f8;font-family:'Outfit',sans-serif;font-size:14px;font-weight:500;
  cursor:pointer;text-align:left;width:100%;transition:all .18s;position:relative;overflow:hidden}
.mcq-btn:hover{border-color:var(--border2);transform:translateX(3px);background:rgba(255,255,255,.05)}
.mcq-btn:disabled{cursor:default;transform:none}
.mcq-ltr{width:28px;height:28px;border-radius:8px;background:rgba(255,255,255,.06);
  display:flex;align-items:center;justify-content:center;font-family:'JetBrains Mono',monospace;
  font-size:11px;color:var(--dim);flex-shrink:0;transition:all .18s}
.mcq-btn.hit{border-color:var(--green);background:rgba(34,217,130,.08);color:var(--green)}
.mcq-btn.hit .mcq-ltr{background:rgba(34,217,130,.18);color:var(--green)}
.mcq-btn.miss{border-color:var(--red);background:rgba(255,77,109,.08);color:var(--red)}
.mcq-btn.miss .mcq-ltr{background:rgba(255,77,109,.18);color:var(--red)}

/* TEXT ANSWER */
.txt-row{display:flex;gap:9px}
.txt-inp{flex:1;padding:15px 17px;background:rgba(255,255,255,.04);border:1px solid var(--border);
  border-radius:13px;color:#eef0f8;font-family:'Outfit',sans-serif;font-size:15px;
  outline:none;transition:border-color .18s,box-shadow .18s}
.txt-inp:focus{border-color:var(--cyan);box-shadow:0 0 0 3px rgba(0,238,255,.08)}
.txt-inp::placeholder{color:var(--dim)}
.txt-inp:disabled{cursor:default}
.txt-inp.hit{border-color:var(--green);background:rgba(34,217,130,.07)}
.txt-inp.miss{border-color:var(--red);background:rgba(255,77,109,.07)}
.btn-val{padding:15px 20px;background:linear-gradient(135deg,var(--cyan),#0891b2);
  color:#001820;border:none;border-radius:13px;font-family:'Outfit',sans-serif;
  font-size:14px;font-weight:800;cursor:pointer;transition:all .18s;white-space:nowrap;flex-shrink:0}
.btn-val:hover{transform:translateY(-1px);box-shadow:0 4px 18px rgba(0,238,255,.3)}
.btn-val:disabled{opacity:.38;cursor:default;transform:none;box-shadow:none}

/* FEEDBACK */
.fb{border-radius:13px;padding:13px 17px;font-size:14px;font-weight:500;
  display:none;align-items:flex-start;gap:11px;line-height:1.5}
.fb.vis{display:flex;animation:qSlide .25s ease both}
.fb.hit{background:rgba(34,217,130,.08);border:1px solid rgba(34,217,130,.22);color:var(--green)}
.fb.miss{background:rgba(255,77,109,.08);border:1px solid rgba(255,77,109,.22);color:var(--red)}
.fb-ico{font-size:20px;flex-shrink:0;margin-top:1px}
.fb-msg strong{color:#eef0f8}
.btn-next{align-self:flex-end;padding:12px 24px;background:var(--s3);border:1px solid var(--border2);
  border-radius:11px;color:#eef0f8;font-family:'Outfit',sans-serif;font-size:14px;font-weight:600;
  cursor:pointer;transition:all .18s;display:none}
.btn-next.vis{display:block}
.btn-next:hover{border-color:var(--gold);color:var(--gold);background:rgba(240,180,41,.06)}

/* MAP */
#mapscreen{background:var(--s1);display:none}
#mapscreen.act{display:flex;flex-direction:column;min-height:100vh}
.map-topbar{display:flex;align-items:center;gap:12px;padding:11px 18px;
  background:rgba(4,6,15,.96);border-bottom:1px solid var(--border);backdrop-filter:blur(18px);
  position:sticky;top:0;z-index:50;flex-wrap:wrap}
.map-qlabel{display:flex;align-items:center;gap:10px;flex:1;min-width:160px}
.map-flag{font-size:26px;flex-shrink:0}
.map-qtxt{font-size:14px;font-weight:700}
.map-qcat{font-size:11px;color:var(--dim);margin-top:1px;font-family:'JetBrains Mono',monospace}
.map-right{display:flex;align-items:center;gap:8px;margin-left:auto}
.chip-map{background:rgba(180,142,255,.1);border:1px solid rgba(180,142,255,.25);color:var(--violet)}

/* Map */
.map-wrap{position:relative;overflow:hidden;background:#050c1c;cursor:crosshair;
  flex:1;min-height:55vw;max-height:72vh}
.map-wrap::before{content:'';position:absolute;top:0;left:0;right:0;height:55px;z-index:5;pointer-events:none;
  background:linear-gradient(to bottom,rgba(5,12,28,.8),transparent)}
.map-wrap::after{content:'';position:absolute;bottom:0;left:0;right:0;height:55px;z-index:5;pointer-events:none;
  background:linear-gradient(to top,rgba(3,8,18,.8),transparent)}
#mapSvg{position:absolute;inset:0;width:100%;height:100%}
#pinsSvg{position:absolute;inset:0;width:100%;height:100%;z-index:10;pointer-events:none}
.click-hint{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;
  justify-content:center;z-index:15;pointer-events:none;transition:opacity .4s}
.click-hint.gone{opacity:0;pointer-events:none}
.ch-ring{width:64px;height:64px;border-radius:50%;border:2px solid rgba(180,142,255,.5);
  animation:chRing 2s ease infinite;display:flex;align-items:center;justify-content:center;font-size:24px}
@keyframes chRing{0%{transform:scale(.8);opacity:1}100%{transform:scale(1.8);opacity:0}}
.ch-txt{font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:.2em;
  text-transform:uppercase;color:rgba(255,255,255,.3);margin-top:14px}
.map-popup{position:absolute;bottom:20px;left:50%;transform:translateX(-50%);
  background:rgba(4,6,15,.96);backdrop-filter:blur(20px);border:1px solid var(--border2);
  border-radius:18px;padding:20px 28px;text-align:center;z-index:20;min-width:220px;
  box-shadow:0 12px 50px rgba(0,0,0,.55);display:none}
.map-popup.vis{display:block;animation:popIn .35s cubic-bezier(.4,0,.2,1) both}
@keyframes popIn{from{opacity:0;transform:translateX(-50%) translateY(12px)}to{opacity:1;transform:translateX(-50%) translateY(0)}}
.pop-dist{font-family:'Bebas Neue',sans-serif;font-size:38px;letter-spacing:.04em;line-height:1;margin-bottom:3px}
.pop-sub{font-size:13px;color:var(--muted);margin-bottom:14px}
.btn-mapnext{padding:10px 24px;border:none;border-radius:10px;
  background:linear-gradient(135deg,var(--violet),#7c3aed);color:#fff;
  font-family:'Outfit',sans-serif;font-size:14px;font-weight:700;cursor:pointer;transition:all .18s;
  box-shadow:0 4px 18px rgba(124,58,237,.35)}
.btn-mapnext:hover{transform:translateY(-1px);box-shadow:0 6px 28px rgba(124,58,237,.5)}

/* RESULTS */
#results{align-items:center;justify-content:center;padding:56px 24px;gap:34px;text-align:center;
  background:radial-gradient(ellipse 80% 45% at 50% -8%,rgba(240,180,41,.07) 0%,transparent 55%)}
.res-ring-wrap{position:relative;width:156px;height:156px;flex-shrink:0}
#resCanvas{border-radius:50%}
.res-ring-inner{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;pointer-events:none}
.res-big{font-family:'Bebas Neue',sans-serif;font-size:52px;line-height:1;color:var(--gold)}
.res-denom{font-size:12px;color:var(--dim);margin-top:2px}
.res-hero{animation:fadeUp .5s ease .3s both}
@keyframes fadeUp{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
.res-title{font-family:'Bebas Neue',sans-serif;font-size:clamp(48px,10vw,80px);letter-spacing:.03em;
  background:linear-gradient(135deg,#fff,var(--gold2));-webkit-background-clip:text;
  -webkit-text-fill-color:transparent;background-clip:text;margin-bottom:6px}
.res-sub{font-size:15px;font-weight:300;color:var(--muted)}
.res-stats{display:flex;gap:10px;flex-wrap:wrap;justify-content:center;animation:fadeUp .5s ease .45s both}
.rs{background:var(--s2);border:1px solid var(--border);border-radius:15px;padding:17px 22px;min-width:85px}
.rs-n{font-family:'Bebas Neue',sans-serif;font-size:42px;line-height:1;display:block}
.rs-l{font-family:'JetBrains Mono',monospace;font-size:9.5px;letter-spacing:.12em;color:var(--dim);text-transform:uppercase;margin-top:3px;display:block}
.res-btns{display:flex;gap:10px;flex-wrap:wrap;justify-content:center;animation:fadeUp .5s ease .6s both}
.btn-replay{padding:17px 38px;border:none;border-radius:14px;
  background:linear-gradient(135deg,var(--gold2),var(--gold),#d97706);color:#160c00;
  font-family:'Outfit',sans-serif;font-size:15px;font-weight:800;cursor:pointer;transition:all .22s;
  box-shadow:0 4px 26px rgba(240,180,41,.28)}
.btn-replay:hover{transform:translateY(-2px);box-shadow:0 10px 46px rgba(240,180,41,.45)}
.btn-home{padding:17px 32px;background:var(--s2);border:1px solid var(--border2);border-radius:14px;
  color:#eef0f8;font-family:'Outfit',sans-serif;font-size:15px;font-weight:600;cursor:pointer;transition:all .18s}
.btn-home:hover{border-color:var(--cyan);color:var(--cyan)}

#confetti{position:fixed;inset:0;z-index:9999;pointer-events:none;display:none}
</style>
</head>
<body>
<canvas id="confetti"></canvas>

<!-- HOME -->
<div id="home" class="screen act">
  <div class="globe-outer">
    <div class="globe-ball"><div class="globe-shine"></div></div>
    <div class="globe-ring"></div><div class="globe-ring2"></div>
  </div>
  <div class="hero">
    <div class="eyebrow"><span></span>Jeu de géographie<span></span></div>
    <h1 class="title"><span class="t1">GÉO</span><span class="t2">QUIZ</span></h1>
    <p class="hero-desc">Capitales · Fleuves · Montagnes<br><b>+ Placement interactif sur carte</b></p>
  </div>
  <div class="badges">
    <div class="badge"><b>100+</b>&nbsp;questions</div>
